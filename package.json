{
  "name": "learnwise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "mobile:sync": "cd frontend && npm run build && npx cap sync android",
    "mobile:open": "cd frontend && npx cap open android"
  },
  "dependencies": {
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
