{
  "appId": "com.learnwise.app",
  "appName": "LearnWise AI",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#080c14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080c14"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
