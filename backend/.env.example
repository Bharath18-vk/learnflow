# LearnWise Backend Environment Variables Template
# Copy this file to .env and configure your secrets

# App URL Configuration
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Security
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secure_32_plus_char_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./learnwise.db

# CORS Allowed Origins (Comma-separated string)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP Configuration (Optional: if blank, emails are logged to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LearnWise <noreply@learnwise.app>

# External AI & API Keys (Optional: fallback engine used if absent)
GEMINI_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
